FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

COPY scripts ./scripts
COPY frontend ./frontend
RUN mkdir -p data/source data/bronze data/silver data/quarantine

EXPOSE 10000

CMD ["sh", "-c", "python scripts/serve_dashboard.py data/source --host 0.0.0.0 --port ${PORT:-10000}"]
